{{define "handler_constructor.tmpl"}}
// {{lower .Name}}Wrapper wraps a user-provided {{.Name}} implementation together
// with the raw CEF struct pointer allocated by {{constructorName .Name}}.  It satisfies the
// {{.Name}} interface (by embedding the user impl) and core.RawPointerHolder
// (so extractRawPointer can recover the raw pointer).
type {{lower .Name}}Wrapper struct {
	{{.Name}}                           // embed user impl for interface delegation
	rawPtr *capi.{{.RawGoName}}
}

func (w *{{lower .Name}}Wrapper) RawPointer() unsafe.Pointer {
	return unsafe.Pointer(w.rawPtr)
}

// {{constructorName .Name}} creates a CEF handler backed by the given implementation.
func {{constructorName .Name}}(impl {{.Name}}) {{.Name}} {
	r := new(capi.{{.RawGoName}})
	initRefCount(unsafe.Pointer(r), unsafe.Sizeof(*r), r)

{{range .Methods}}
	{{- if .IsGetter}}
	// Cache the fully-wrapped handler once to avoid allocating on every callback.
	var cached{{.Name}}Ptr unsafe.Pointer
	if h := impl.{{.Name}}(); h != nil {
		cached{{.Name}}Ptr = extractOrWrapRawPointer(h, func() any {
			return {{constructorName .GetterInterface}}(h)
		})
	}
	r.Override{{.RawFieldName}}(purego.NewCallback(func(_ uintptr) uintptr {
		if cached{{.Name}}Ptr != nil {
			addRef(cached{{.Name}}Ptr)
		}
		return uintptr(cached{{.Name}}Ptr)
	}))
	{{- else}}
	{{- $rawPs := .RawParams}}
	r.Override{{.RawFieldName}}(purego.NewCallback(func(self uintptr{{range $i, $p := .RawParams}}, {{cbParamName $p $i}} {{if isFloatPublicType $p.PublicType}}{{$p.PublicType}}{{else}}uintptr{{end}}{{end}}) {{if .Return.IsVoid}}{{else}}uintptr{{end}} {
		{{- range $i, $p := .Params}}
		{{- if eq $p.MarshalKind "slice"}}
		{{$p.Name}} := decodeSlice[{{$p.SliceElemType}}]({{slicePtrArg $p $rawPs}}, int({{sliceCountArg $p $rawPs}}))
		{{- else if eq $p.MarshalKind "objectSlice"}}
		{{unmarshalObjectSlice $p $rawPs}}
		{{- else}}
		{{$p.Name}} := {{unmarshalParam $p (rawArgForParam $p $rawPs)}}
		{{- end}}
		{{- end}}
		{{- if .Return.IsVoid}}
		impl.{{.Name}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}}{{end}})
		{{- else if .Return.IsBool}}
		if impl.{{.Name}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}}{{end}}) {
			return 1
		}
		return 0
		{{- else if .Return.IsHandler}}
		result := impl.{{.Name}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}}{{end}})
		if result == nil {
			return 0
		}
		return uintptr(extractOrWrapRawPointer(result, func() any {
			return {{constructorName .Return.PublicType}}(result)
		}))
		{{- else if .Return.IsInterface}}
		return uintptr(extractRawPointer(impl.{{.Name}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}}{{end}})))
		{{- else}}
		return uintptr(impl.{{.Name}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}}{{end}}))
		{{- end}}
	}))
	{{- end}}
{{end}}

	w := &{{lower .Name}}Wrapper{rawPtr: r}
	w.{{.Name}} = impl
	return w
}

type {{lower .Name}}Impl struct {
	rawPtr *capi.{{.RawGoName}}
}

{{range .Methods}}
func (obj *{{lower $.Name}}Impl) {{.Name}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}} {{$p.PublicType}}{{end}}){{if not .Return.IsVoid}} {{.Return.PublicType}}{{end}} {
	{{- range .Params}}
	{{- $pre := marshalPreamble .}}
	{{- if $pre}}
	{{$pre}}
	{{- end}}
	{{- end}}
	{{- with methodPreamble $.Name .}}
{{.}}{{- end}}
	{{- if needsTypedObjectCall .}}
	var fn {{typedObjectFuncSig $.RawGoName .}}
	purego.RegisterFunc(&fn, obj.rawPtr.{{.RawFieldName}})
	{{- if .Return.IsVoid}}
	fn({{typedObjectCallArgs .}})
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
	{{- else}}
	ret := fn({{typedObjectCallArgs .}})
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
		{{- if .Return.IsBool}}
	return ret != 0
		{{- else if .Return.IsEnum}}
	return {{.Return.PublicType}}(ret)
		{{- else if .Return.IsString}}
	return goStringUserfree(unsafe.Pointer(ret))
		{{- else if .Return.IsInterface}}
	return {{wrapFuncName .Return.PublicType}}(unsafe.Pointer(ret))
		{{- else if .Return.IsDataStruct}}
	return ({{.Return.PublicType}})(unsafe.Pointer(ret))
		{{- else if .Return.IsPointer}}
	return unsafe.Pointer(ret)
		{{- else if .Return.IsNumeric}}
			{{- if isFloatPublicType .Return.PublicType}}
	return ret
			{{- else}}
	return {{.Return.PublicType}}(ret)
			{{- end}}
		{{- else}}
	return {{.Return.PublicType}}(ret)
		{{- end}}
	{{- end}}
	{{- else if .Return.IsVoid}}
	obj.rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}})
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
	{{- else}}
	ret := obj.rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}})
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
		{{- if .Return.IsBool}}
	return ret != 0
		{{- else if .Return.IsEnum}}
	return {{.Return.PublicType}}(ret)
		{{- else if .Return.IsString}}
	return goStringUserfree(unsafe.Pointer(ret))
		{{- else if .Return.IsInterface}}
	return {{wrapFuncName .Return.PublicType}}(unsafe.Pointer(ret))
		{{- else if .Return.IsDataStruct}}
	return ({{.Return.PublicType}})(unsafe.Pointer(ret))
		{{- else if .Return.IsPointer}}
	return unsafe.Pointer(ret)
		{{- else if .Return.IsNumeric}}
	return {{.Return.PublicType}}(ret)
		{{- else}}
	return {{.Return.PublicType}}(ret)
		{{- end}}
	{{- end}}
}
{{end}}

func (obj *{{lower .Name}}Impl) RawPointer() unsafe.Pointer {
	return unsafe.Pointer(obj.rawPtr)
}

{{if .IsScoped}}
func wrap{{.Name}}(ptr unsafe.Pointer) {{.Name}} {
	if ptr == nil {
		return nil
	}
	r := (*capi.{{.RawGoName}})(ptr)
	return &{{lower .Name}}Impl{rawPtr: r}
}
{{else}}
// Release releases the underlying CEF object.
func (obj *{{lower .Name}}Impl) Release() {
	base := (*capi.CEFBaseRefCountedT)(unsafe.Pointer(obj.rawPtr))
	base.CallRelease()
}

// wrap{{.Name}} wraps a CEF handler pointer received from CEF into a thin Go façade.
func wrap{{.Name}}(ptr unsafe.Pointer) {{.Name}} {
	if ptr == nil {
		return nil
	}
	r := (*capi.{{.RawGoName}})(ptr)
	base := (*capi.CEFBaseRefCountedT)(ptr)
	base.CallAddRef()
	impl := &{{lower .Name}}Impl{rawPtr: r}
	runtime.SetFinalizer(impl, func(o *{{lower .Name}}Impl) {
		b := (*capi.CEFBaseRefCountedT)(unsafe.Pointer(o.rawPtr))
		b.CallRelease()
	})
	return impl
}
