	r.Override{{.RawFieldName}}(purego.NewCallback(func(_ uintptr) uintptr {
		_ = cached{{.Name}}
		return 0 // TODO: marshal cached result
	}))
	{{- else}}
	r.Override{{.RawFieldName}}(purego.NewCallback(func({{range $i, $p := .Params}}{{if $i}}, {{end}}_ uintptr{{end}}) {{if .Return.IsVoid}}{{else}}uintptr{{end}} {
		{{- if not .Return.IsVoid}}
		// TODO: unmarshal args, call impl.{{.Name}}(...), marshal return
		return 0
		{{- else}}
		// TODO: unmarshal args, call impl.{{.Name}}(...)
		{{- end}}
	}))
	{{- end}}
{{end}}

	return unsafe.Pointer(r)
}
