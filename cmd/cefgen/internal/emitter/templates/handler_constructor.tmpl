// {{constructorName .Name}} creates a CEF handler backed by the given implementation.
func {{constructorName .Name}}(impl {{.Name}}) {{.Name}} {
	if isNilImpl(impl) {
		return nil
	}
	r := new(capi.{{.RawGoName}})
	w := &{{lower .Name}}Wrapper{rawPtr: r}
	w.{{.Name}} = impl
	initRefCount(unsafe.Pointer(r), unsafe.Sizeof(*r), w)

{{range .Methods}}
	{{- if .IsGetter}}
	// Cache the fully-wrapped handler once and dispatch through a shared callback.
	if h := impl.{{.Name}}(); !isNilImpl(h) {
		w.cached{{.Name}}Ptr = extractOrWrapRawPointer(h, func() any {
			return {{constructorName .GetterInterface}}(h)
		})
		r.Override{{.RawFieldName}}({{lower $.Name}}{{.RawFieldName}}CEFCallback())
	}
	{{- else}}
	r.Override{{.RawFieldName}}({{lower $.Name}}{{.RawFieldName}}CEFCallback())
	{{- end}}
{{end}}

	return w
}

