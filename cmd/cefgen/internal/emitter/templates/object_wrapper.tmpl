// Release releases the underlying CEF object.
func (obj *{{lower .Name}}Impl) Release() {
	base := (*raw.CEFBaseRefCountedT)(unsafe.Pointer(obj.rawPtr))
	base.CallRelease()
}

func wrap{{.Name}}(ptr unsafe.Pointer) {{.Name}} {
	if ptr == nil {
		return nil
	}
	r := (*raw.{{.RawGoName}})(ptr)
	base := (*raw.CEFBaseRefCountedT)(ptr)
	base.CallAddRef()
	impl := &{{lower .Name}}Impl{rawPtr: r}
	runtime.SetFinalizer(impl, func(o *{{lower .Name}}Impl) {
		b := (*raw.CEFBaseRefCountedT)(unsafe.Pointer(o.rawPtr))
		b.CallRelease()
	})
	return impl
}
