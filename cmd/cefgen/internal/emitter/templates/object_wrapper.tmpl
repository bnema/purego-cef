		{{- else}}
	return {{.Return.PublicType}}(fn({{typedObjectCallArgs .}}))
		{{- end}}
	{{- else}}
	return {{.Return.PublicType}}(fn({{typedObjectCallArgs .}}))
	{{- end}}
