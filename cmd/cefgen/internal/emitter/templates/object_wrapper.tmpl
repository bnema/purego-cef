{{define "object_wrapper.tmpl"}}
// {{lower .Name}}Impl is a reverse wrapper for a CEF-owned {{.Name}} pointer.
// Release is idempotent, but callers must externally synchronize Release with
// concurrent method calls and must not use the wrapper after Release returns.
type {{lower .Name}}Impl struct {
	rawPtr *capi.{{.RawGoName}}
{{- if not .IsScoped}}
	releaseOnce sync.Once
{{- end}}
{{- range .Methods}}
{{- if needsTypedObjectCall .}}
	{{lower .Name}}Once sync.Once
	{{lower .Name}}Func {{typedObjectFuncSig $.RawGoName .}}
{{- end}}
{{- end}}
}

{{range .Methods}}
func (obj *{{lower $.Name}}Impl) {{.Name}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{$p.Name}} {{$p.PublicType}}{{end}}){{if not .Return.IsVoid}} {{.Return.PublicType}}{{end}} {
	if obj == nil || obj.rawPtr == nil {
		{{- if .Return.IsVoid}}
		return
		{{- else}}
		return {{zeroReturn .Return}}
		{{- end}}
	}
	rawPtr := obj.rawPtr
	{{- if hasRefCountedTransfers .}}
	if rawPtr.{{.RawFieldName}} == 0 {
		return{{if not .Return.IsVoid}} {{zeroReturn .Return}}{{end}}
	}
	{{- end}}
	{{- range .Params}}
	{{- $pre := marshalPreamble .}}
	{{- if $pre}}
	{{$pre}}
	{{- end}}
	{{- end}}
	{{- with methodPreamble $.Name .}}
{{.}}{{- end}}
	{{- range .Params}}{{if and .IsRefCountedTransfer (eq .MarshalKind "interface")}}
	{{.Name}}Ptr := {{refCountedTransferPointerExpr .}}
	transferRef({{.Name}}Ptr)
	{{- else if and .IsRefCountedTransfer (eq .MarshalKind "objectSlice")}}
	for _, ptr := range {{.Name}}Raw {
		transferRef(unsafe.Pointer(ptr))
	}
	{{- end}}{{end}}
	{{- $hasPost := hasMarshalPostamble .Params}}
	{{- if needsTypedObjectCall .}}
	obj.{{lower .Name}}Once.Do(func() {
		registerTypedCallback(&obj.{{lower .Name}}Func, rawPtr.{{.RawFieldName}})
	})
	{{- if .Return.IsVoid}}
	obj.{{lower .Name}}Func({{typedObjectCallArgs .}})
	{{- range .Params}}{{if .IsRefCountedTransfer}}
	runtime.KeepAlive({{.Name}})
	{{- end}}{{end}}
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
	{{- else}}
	ret := obj.{{lower .Name}}Func({{typedObjectCallArgs .}})
	{{- range .Params}}{{if .IsRefCountedTransfer}}
	runtime.KeepAlive({{.Name}})
	{{- end}}{{end}}
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
		{{- if .Return.IsBool}}
	return ret != 0
		{{- else if .Return.IsEnum}}
	return {{.Return.PublicType}}(ret)
		{{- else if .Return.IsString}}
	return goStringUserfree(unsafe.Pointer(ret))
		{{- else if .Return.IsInterface}}
	return {{wrapFuncName .Return.PublicType}}(unsafe.Pointer(ret))
		{{- else if .Return.IsDataStruct}}
	return ({{.Return.PublicType}})(unsafe.Pointer(ret))
		{{- else if .Return.IsPointer}}
	return unsafe.Pointer(ret)
		{{- else if .Return.IsNumeric}}
			{{- if isFloatPublicType .Return.PublicType}}
	return ret
			{{- else}}
	return {{.Return.PublicType}}(ret)
			{{- end}}
		{{- else}}
	return {{.Return.PublicType}}(ret)
		{{- end}}
	{{- end}}
	{{- else if .Return.IsVoid}}
	rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}})
	{{- range .Params}}{{if .IsRefCountedTransfer}}
	runtime.KeepAlive({{.Name}})
	{{- end}}{{end}}
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
	{{- else}}
	ret := rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}})
	{{- range .Params}}{{if .IsRefCountedTransfer}}
	runtime.KeepAlive({{.Name}})
	{{- end}}{{end}}
	{{- range .Params}}{{with marshalPostamble .}}
	{{.}}
	{{- end}}{{end}}
		{{- if .Return.IsBool}}
	return ret != 0
		{{- else if .Return.IsEnum}}
	return {{.Return.PublicType}}(ret)
		{{- else if .Return.IsString}}
	return goStringUserfree(unsafe.Pointer(ret))
		{{- else if .Return.IsInterface}}
	return {{wrapFuncName .Return.PublicType}}(unsafe.Pointer(ret))
		{{- else if .Return.IsDataStruct}}
	return ({{.Return.PublicType}})(unsafe.Pointer(ret))
		{{- else if .Return.IsPointer}}
	return unsafe.Pointer(ret)
		{{- else if .Return.IsNumeric}}
	return {{.Return.PublicType}}(ret)
		{{- else}}
	return {{.Return.PublicType}}(ret)
		{{- end}}
	{{- end}}
}
{{end}}

func (obj *{{lower .Name}}Impl) RawPointer() unsafe.Pointer {
	if obj == nil || obj.rawPtr == nil {
		return nil
	}
	return unsafe.Pointer(obj.rawPtr)
}

{{if .IsScoped}}
func wrap{{.Name}}(ptr unsafe.Pointer) {{.Name}} {
	if ptr == nil {
		return nil
	}
	r := (*capi.{{.RawGoName}})(ptr)
	return &{{lower .Name}}Impl{rawPtr: r}
}
{{else}}
// Release releases the underlying CEF object.
func (obj *{{lower .Name}}Impl) Release() {
	if obj == nil {
		return
	}
	obj.releaseOnce.Do(func() {
		if obj.rawPtr == nil {
			return
		}
		rawPtr := obj.rawPtr
		obj.rawPtr = nil
		runtime.SetFinalizer(obj, nil)
		base := (*capi.CEFBaseRefCountedT)(unsafe.Pointer(rawPtr))
		base.CallRelease()
	})
}

func wrap{{.Name}}(ptr unsafe.Pointer) {{.Name}} {
	if ptr == nil {
		return nil
	}
	r := (*capi.{{.RawGoName}})(ptr)
	base := (*capi.CEFBaseRefCountedT)(ptr)
	base.CallAddRef()
	impl := &{{lower .Name}}Impl{rawPtr: r}
	runtime.SetFinalizer(impl, (*{{lower .Name}}Impl).Release)
	return impl
}
{{if .NeedsTake}}
// take{{.Name}} adopts a CEF {{.Name}} pointer whose reference is already owned by
// the caller (as returned by a global factory function). Unlike wrap{{.Name}} it
// does NOT call AddRef, because the C API already transferred one reference to us.
func take{{.Name}}(ptr unsafe.Pointer) {{.Name}} {
	if ptr == nil {
		return nil
	}
	r := (*capi.{{.RawGoName}})(ptr)
	impl := &{{lower .Name}}Impl{rawPtr: r}
	runtime.SetFinalizer(impl, (*{{lower .Name}}Impl).Release)
	return impl
}
{{end}}
{{end}}
{{end}}
