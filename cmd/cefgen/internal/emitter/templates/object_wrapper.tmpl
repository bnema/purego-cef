	return wrap{{.Return.PublicType}}(unsafe.Pointer(obj.rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}})))
	{{- else if .Return.IsDataStruct}}
	return ({{.Return.PublicType}})(unsafe.Pointer(obj.rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}})))
	{{- else if .Return.IsPointer}}
	return unsafe.Pointer(obj.rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}}))
	{{- else if .Return.IsNumeric}}
	return {{.Return.PublicType}}(obj.rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}}))
	{{- else}}
	return {{.Return.PublicType}}(obj.rawPtr.Call{{.RawFieldName}}({{marshalCallArgs .Params}}))
	{{- end}}
}
