	{{- else if .Return.IsEnum}}
	return {{.Return.PublicType}}(raw.{{.RawGoName}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{marshalParamForRawFunc $p}}{{end}}))
	{{- else if .Return.IsString}}
	return goStringUserfree(unsafe.Pointer(raw.{{.RawGoName}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{marshalParamForRawFunc $p}}{{end}})))
	{{- else if .Return.IsInterface}}
	return wrap{{.Return.PublicType}}(raw.{{.RawGoName}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{marshalParamForRawFunc $p}}{{end}}))
	{{- else if .Return.IsNumeric}}
	return {{.Return.PublicType}}(raw.{{.RawGoName}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{marshalParamForRawFunc $p}}{{end}}))
	{{- else if .Return.IsPointer}}
	return raw.{{.RawGoName}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{marshalParamForRawFunc $p}}{{end}})
	{{- else}}
	return {{.Return.PublicType}}(raw.{{.RawGoName}}({{range $i, $p := .Params}}{{if $i}}, {{end}}{{marshalParamForRawFunc $p}}{{end}}))
	{{- end}}
}
